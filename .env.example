# --- required ---
DATABASE_URL=postgresql://chatbot:chatbot@db:5432/chatbot
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
ADMIN_EMAIL=you@example.com
# 12+ characters, enforced at startup
ADMIN_PASSWORD=choose-a-long-unique-password
# public URL of this deployment (used to allow the dashboard's own test chat)
PUBLIC_BASE_URL=http://localhost:8000

# --- platform services (embeddings + web search are paid/free-tier APIs YOU own) ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
TAVILY_API_KEY=

# --- platform LLM keys used when a client does not bring their own (can also be set in the admin dashboard) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# --- email (required for clients to change their password: every change needs an emailed code) ---
# Free: Brevo, 300 emails/day, works on free hosting (SMTP is blocked there, this uses Brevo's HTTPS API).
# 1) create a Brevo account  2) Settings > Senders > add and verify an address you own  3) Settings > API keys > create a key
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Chatbot Console

# --- optional ---
CONTACT_EMAIL=
SENTRY_DSN=
RETENTION_DAYS=90
# Render: true-client-ip. Elsewhere leave empty and set PROXY_HOPS to the number of proxies in front of the app.
CLIENT_IP_HEADER=
PROXY_HOPS=1
# Max characters of the knowledge base a single reply may copy word for word
MAX_VERBATIM_CHARS=600
